# Entorno y Configuración General
PROJECT_NAME="INNOVAIT B2B Multi-Agent Sales System"
ENVIRONMENT="development"
DEBUG=True
API_V1_PREFIX="/api/v1"

# LLM Providers (Google Gemini)
GEMINI_API_KEY="AIzaSy..."
DEFAULT_FAST_MODEL="gemini-2.5-flash"
DEFAULT_REASONING_MODEL="gemini-2.5-pro"

# APIs de Enriquecimiento e Inteligencia Comercial (Agente 1)
APOLLO_API_KEY=""
HUNTER_API_KEY=""
