# Base de Datos PostgreSQL con pgvector y LangGraph Checkpointing
DATABASE_URL="postgresql+asyncpg://innovait_user:innovait_password@localhost:5432/innovait_sales"
SYNC_DATABASE_URL="postgresql://innovait_user:innovait_password@localhost:5432/innovait_sales"

# Frontend / CORS
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
